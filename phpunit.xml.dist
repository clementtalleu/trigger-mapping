<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.1/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         executionOrder="depends,defects"
         displayDetailsOnTestsThatTriggerWarnings="true"
>
    <php>
        <env name="APP_ENV" value="test"/>
        <env name="APP_DEBUG" value="1"/>
        <env name="APP_SECRET" value="test_secret"/>
        <!-- Quiet down Symfony's default logger so EventDispatcher [debug] notifications
             don't spam phpunit's output. The HttpKernel\Log\Logger reads SHELL_VERBOSITY:
             -1 means "quiet" → only ERROR-level messages are emitted. -->
        <env name="SHELL_VERBOSITY" value="-1"/>

        <env name="KERNEL_CLASS" value="Talleu\TriggerMapping\Tests\Application\Kernel"/>
        <!-- Default: MySQL. For PostgreSQL use `phpunit -c phpunit-postgresql.xml.dist`, for SQL Server `phpunit -c phpunit-sqlserver.xml.dist`. -->
        <env name="DATABASE_URL" value="mysql://test_user:test_password@127.0.0.1:3308/test_db?serverVersion=8.0"/>
    </php>

    <testsuites>
        <testsuite name="mysql">
            <directory>tests/Functional/Mysql</directory>
        </testsuite>
        <testsuite name="postgresql">
            <directory>tests/Functional/Postgresql</directory>
        </testsuite>
        <testsuite name="sqlserver">
            <directory>tests/Functional/SqlServer</directory>
        </testsuite>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>

    <source ignoreIndirectDeprecations="true" restrictNotices="true" restrictWarnings="true">
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
